# MCP Server Inspector - Environment Variables
# Copy this to .env and fill in your actual values

# Required for AI analysis (Phase 2 & 3 of inspection)
OPENAI_API_KEY=sk-proj-your-openai-key-here

# Optional - only needed if inspecting these specific MCP servers
GITHUB_PERSONAL_ACCESS_TOKEN=github_pat_your-token-here
NOTION_TOKEN=secret_your-notion-token-here
LINEAR_API_KEY=lin_api_your-linear-key-here

# Allow the /mcp-proxy CORS-bypass route to reach loopback/private addresses.
# Off by default: the proxy fetches a URL supplied by the browser, so without this
# guard it could be pointed at internal services or the cloud metadata endpoint.
# Set to 1 only to test against an MCP server running on your own machine.
# MCP_PROXY_ALLOW_PRIVATE=1

# --- API bridge access control ----------------------------------------------
# The API server binds 127.0.0.1 only and, with no token set, answers loopback
# callers alone. Set MCP_INSPECTOR_TOKEN to require `Authorization: Bearer
# <token>` from every caller (including localhost) — this is the supported way
# to expose the API beyond your own machine (pair it with a wider bind or an
# SSH tunnel).
# MCP_INSPECTOR_TOKEN=choose-a-long-random-token

# Stdio inspection and GitHub-repo batch targets spawn a subprocess built from
# request-supplied commands / README-parsed commands — arbitrary code execution
# by design. They are disabled unless you opt in here. Leave unset on any
# deployment reachable by machines you don't fully trust.
# MCP_INSPECTOR_ALLOW_STDIO=1

# Path to the CCI Research Toolkit repo (used for richer HTTP capability discovery)
# Defaults to the sibling repo location: ../../../../../../mcp-tools/cci-research-toolkit
# relative to this project. Override here only if your toolkit lives elsewhere.
CCI_TOOLKIT_PATH=/Users/srinathp/MCP/mcp-tools/cci-research-toolkit
