Example 1: GitHub-Hosted Server
{
  "name": "github-server",
  "connection_type": "sse",
  "endpoint_url": "https://api.github.com/mcp",
  "authentication": {
    "type": "personal_access_token"
  },
  "repository": "https://github.com/modelcontextprotocol/server",
  "pricing": "free"
}

Example 2: Commercial SaaS Server
{
  "name": "commercial-server",
  "connection_type": "sse",
  "endpoint_url": "https://api.myservice.com/mcp/v1",
  "mcp_version": "2025-06-18",
  "authentication": {
    "type": "oauth",
    "flow": "authorization_code"
  },
  "tls_version": "1.3",
  "pricing": "paid",
  "deployment": "remote"
}

Example 3: Self-Hosted Docker Server
{
  "name": "docker-server",
  "connection_type": "sse",
  "endpoint_url": "https://mcp.mydomain.com:8080/mcp",
  "deployment": "container",
  "tls_version": "1.3",
  "pricing": "free",
  "repository": "https://github.com/myorg/mcp-docker"
}

